{
  "bind": "127.0.0.1:7100",
  "origin": "http://127.0.0.1:7100",
  "auth": {
    "mode": "oidc",
    "trust": [
      {
        "issuer": "https://auth.example.org/application/o/nils/",
        "audience": "the-client-id",
        "jwks": "https://auth.example.org/application/o/nils/jwks/"
      }
    ],
    "groupsClaim": "roles",
    "roles": {
      "reader": "reader",
      "reviewer": "reviewer",
      "operator": "operator",
      "admin": "admin"
    }
  },
  "store": "kvasir.sqlite",
  "pepperFile": "kvasir.pepper",
  "admission": {
    "queue": 8,
    "waitCapSeconds": 60
  },
  "sealKeyFile": "kvasir.seal",
  "purposes": [
    {
      "id": "assistant.ask-help",
      "app": "nils-assistant",
      "content": "rows",
      "kind": "foreground",
      "description": "turn words into an ask document, or tune one step of it"
    },
    {
      "id": "assistant.compaction",
      "app": "nils-assistant",
      "content": "rows",
      "kind": "background"
    },
    {
      "id": "assistant.title",
      "app": "nils-assistant",
      "content": "catalog",
      "kind": "background"
    }
  ],
  "local": {
    "endpoint": "https://huggingface.co"
  }
}
